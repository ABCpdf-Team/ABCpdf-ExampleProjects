<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WPFTable;assembly=WPFTable">
    <Page.Resources>
        <XmlDataProvider x:Key="InvoiceDataProvider" Source="../XMLTables/travelfun.xml" IsAsynchronous="False"/>
        <c:InvoiceDataConverter x:Key="InvoiceDataConverter" />
    </Page.Resources>

    <FlowDocumentPageViewer Name="DocViewer" Width="850" Height="900">
        <FlowDocument  
        Name="Invoice"
        FontFamily="Times New Roman" FontSize="18"  ColumnWidth="800"
        IsOptimalParagraphEnabled="True" IsHyphenationEnabled="True"
        LineHeight="30">

            <Table Name="CompanyHeader">
                <Table.Columns>
                    <TableColumn Width="120"/>
                    <TableColumn Width="40" />
                    <TableColumn />
                </Table.Columns>

                <TableRowGroup DataContext="{Binding Source={StaticResource InvoiceDataProvider}, XPath=/Invoice/CompanyInfo}">
                    <TableRow>
                        <TableCell RowSpan="4">
                            <Paragraph>
                                <Image Source="{Binding XPath=@logo}" />
                            </Paragraph>
                        </TableCell>
                        <TableCell RowSpan="4" />
                        <TableCell FontSize="54">
                            <Paragraph>
                                <TextBlock Text="{Binding XPath=@Name}" />
                    </Paragraph>
                        </TableCell>
                    </TableRow>
                    <TableRow>
                        <TableCell>
                            <Paragraph>
                                <TextBlock Text="{Binding XPath=@Address}" />
                    </Paragraph>
                        </TableCell>
                    </TableRow>
                    <TableRow>
                        <TableCell>
                            <Paragraph>
                                <TextBlock Text="{Binding XPath=@City}"/>,
                            <TextBlock Text="{Binding XPath=@State}"/>,
                            <TextBlock Text="{Binding XPath=@Zip}"/>
                    </Paragraph>
                        </TableCell>
                    </TableRow>
                    <TableRow>
                        <TableCell>
                            <Paragraph>
                                <TextBlock Text="{Binding XPath=@Phone}" />
                    </Paragraph>
                        </TableCell>
                    </TableRow>
                </TableRowGroup>

            </Table>

            <Table>
                <Table.Columns>
                    <TableColumn Width="450"/>
                    <TableColumn Width="302"/>
                </Table.Columns>
                <TableRowGroup>
                    <TableRow>
                        <TableCell>
                            <Table Name="CustomerHeader" BorderBrush="Black" BorderThickness="1" Margin="0,0,10,0">
                                <Table.Columns>
                                    <TableColumn Width="100"/>
                                    <TableColumn />
                                </Table.Columns>
                                <TableRowGroup DataContext="{Binding Source={StaticResource InvoiceDataProvider}, XPath=/Invoice/Customer}">
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Name</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@Name}" />
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell RowSpan="2">
                                            <Paragraph>Address</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@Address}" />
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@City}"/>
                                                <Run Text=","/>
                                                <TextBlock Text="{Binding XPath=@State}"/>
                                                <Run Text=","/>
                                                <TextBlock Text="{Binding XPath=@Zip}"/>
                                        </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Phone</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@Phone}" />
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                </TableRowGroup>
                            </Table>
                        </TableCell>
                        <TableCell>
                            <Table Name="OrderHeader" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                                <Table.Columns>
                                    <TableColumn />
                                    <TableColumn />
                                </Table.Columns>
                                <TableRowGroup DataContext="{Binding Source={StaticResource InvoiceDataProvider}, XPath=/Invoice/Order}">
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Date</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@Date}"/></Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Order No</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@OrderNo}"/>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Rep</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@Rep}"/></Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>FOB</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@FOB}"/></Paragraph>
                                        </TableCell>
                                    </TableRow>
                                </TableRowGroup>
                            </Table>
                        </TableCell>
                    </TableRow>
                </TableRowGroup>
            </Table>

            <Table Name="ItemsTable">
                <Table.Columns>
                    <TableColumn Width="80" />
                    <TableColumn Width="450"/>
                    <TableColumn Width="100"/>
                    <TableColumn Width="100"/>
                </Table.Columns>
                <TableRowGroup>
                    <TableRow>
                        <TableCell ColumnSpan="4" LineHeight="1">
                            <BlockUIContainer>
                                <Line X1="0" Y1="0" X2="800" Y2="0" Stroke="Black" StrokeThickness="3" />
                            </BlockUIContainer>
                        </TableCell>
                    </TableRow>
                    <TableRow Background="WhiteSmoke">
                        <TableCell>
                            <Paragraph>Qty</Paragraph>
                        </TableCell>
                        <TableCell>
                            <Paragraph>Description</Paragraph>
                        </TableCell>
                        <TableCell>
                            <Paragraph>Unit Price</Paragraph>
                        </TableCell>
                        <TableCell>
                            <Paragraph>Total</Paragraph>
                        </TableCell>
                    </TableRow>
                    <TableRow>
                        <TableCell ColumnSpan="4" LineHeight="1">
                            <BlockUIContainer>
                                <Line X1="0" Y1="0" X2="800" Y2="0" Stroke="Black" StrokeThickness="3" />
                            </BlockUIContainer>
                        </TableCell>
                    </TableRow>
                </TableRowGroup>
                <TableRowGroup DataContext="{Binding Source={StaticResource InvoiceDataProvider}, XPath=/Invoice/Order/Item[1]}">
                    <TableRow>
                        <TableCell Background="WhiteSmoke">
                            <Paragraph>
                                <TextBlock Text="{Binding XPath=@Qty}" />
                            </Paragraph>
                        </TableCell>
                        <TableCell>
                            <Paragraph>
                                <TextBlock Text="{Binding XPath=@Desc}" />
                            </Paragraph>
                        </TableCell>
                        <TableCell>
                            <Paragraph>
                                <TextBlock Text="{Binding XPath=@UnitPrice}" />
                            </Paragraph>
                        </TableCell>
                        <TableCell Background="WhiteSmoke">
                            <Paragraph>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource InvoiceDataConverter}">
                                            <Binding XPath="@Qty"/>
                                            <Binding XPath="@UnitPrice"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Paragraph>
                        </TableCell>
                    </TableRow>
                </TableRowGroup>
            </Table>
            
            <Table>
                <Table.Columns>
                    <TableColumn Width="80" />
                    <TableColumn Width="450"/>
                    <TableColumn Width="100"/>
                    <TableColumn Width="100"/>
                </Table.Columns>
                    <TableRowGroup>
                    <TableRow>
                        <TableCell ColumnSpan="4" LineHeight="1">
                            <BlockUIContainer>
                                <Line X1="0" Y1="0" X2="800" Y2="0" Stroke="Black" StrokeThickness="2" />
                            </BlockUIContainer>
                        </TableCell>
                    </TableRow>
                    <TableRow>
                        <TableCell ColumnSpan="2">
                            <Table Name="PaymentDetails" BorderBrush="Black" BorderThickness="1" Margin="20">
                                <Table.Columns>
                                    <TableColumn Width="150"/>
                                    <TableColumn Width="150"/>
                                </Table.Columns>
                                <TableRowGroup DataContext="{Binding Source={StaticResource InvoiceDataProvider}, XPath=/Invoice/PaymentDetails}">
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Payment Type</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@Payment}"/>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Name</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@Name}"/>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>CC#</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding XPath=@CC}"/>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Expires</Paragraph>
                                        </TableCell>
                                        <TableCell>
                                            <Paragraph>
                                                <TextBlock Text="{Binding XPath=@Expires}"/>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                </TableRowGroup>
                            </Table>
                        </TableCell>
                        <TableCell ColumnSpan="2">
                            <Table Name="Totals" Margin="0,0,0,0">
                                <Table.Columns>
                                    <TableColumn Width="100"/>
                                    <TableColumn Width="100"/>
                                </Table.Columns>
                                <TableRowGroup>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>SubTotal</Paragraph>
                                        </TableCell>
                                        <TableCell Background="WhiteSmoke">
                                            <Paragraph>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource InvoiceDataConverter}" ConverterParameter="SubTotal" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                </TableRowGroup>
                                <TableRowGroup>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Shipping</Paragraph>
                                        </TableCell>
                                        <TableCell Background="WhiteSmoke">
                                            <Paragraph>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource InvoiceDataConverter}" ConverterParameter="Shipping" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                </TableRowGroup>
                                <TableRowGroup>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Taxes</Paragraph>
                                        </TableCell>
                                        <TableCell Background="WhiteSmoke">
                                            <Paragraph>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource InvoiceDataConverter}" ConverterParameter="Tax" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                </TableRowGroup>
                                <TableRowGroup>
                                    <TableRow>
                                        <TableCell>
                                            <Paragraph>Total</Paragraph>
                                        </TableCell>
                                        <TableCell Background="WhiteSmoke">
                                            <Paragraph>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource InvoiceDataConverter}" ConverterParameter="Total" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Paragraph>
                                        </TableCell>
                                    </TableRow>
                                </TableRowGroup>
                            </Table>
                            
                        </TableCell>
                    </TableRow>
                </TableRowGroup>
            </Table>
                            
        </FlowDocument>
    </FlowDocumentPageViewer>
</Page>