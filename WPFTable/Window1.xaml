    Title="Space Sample" Height="1000" Width="900">

    <Window.Resources>
       
    </Window.Resources>

    <StackPanel Name="MainArea">
        <Menu >
            <MenuItem Header="File">
                <MenuItem Header="Save as PDF" Click="SaveAsPdf_Click" />
                <MenuItem Header="Save as XPS" Click="SaveAsXps_Click" />
