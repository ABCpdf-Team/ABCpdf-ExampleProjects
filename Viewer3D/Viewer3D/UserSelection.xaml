<Window x:Class="Viewer3D.UserSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Viewer3D"
        mc:Ignorable="d"
        Title="Select 3D Annotation" Height="300" Width="600">
    <Grid>
        <ListBox x:Name="Listbox_Selection" HorizontalAlignment="Left" Height="223" Margin="10,10,0,0" VerticalAlignment="Top" Width="572"/>
        <Button x:Name="Button_Cancel" Content="Cancel" HorizontalAlignment="Left" Margin="10,240,0,0" VerticalAlignment="Top" Width="75" Click="Button_Cancel_Click"/>
        <Button x:Name="Button_Select" Content="Select" HorizontalAlignment="Left" Margin="507,240,0,0" VerticalAlignment="Top" Width="75" Click="Button_Select_Click"/>

    </Grid>
</Window>
